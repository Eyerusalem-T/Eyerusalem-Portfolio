# Copy this file to .env and fill in real values before running the server.

# Port the API listens on
PORT=4000

# Comma-separated list of origins allowed to call this API from a browser.
# Use your deployed frontend URL, e.g. https://yourname.dev
# Use * only for local testing.
ALLOWED_ORIGINS=http://eyerusalem-portfolio-backend.onrender.com/

# Secret token the /admin page uses to authenticate. Make this long and random.
ADMIN_TOKEN=qwertyuiop12345678

# Where "new message" notifications and outgoing replies appear to come from.
ADMIN_EMAIL=eyerusalem0201@gmail.com

# --- SMTP settings used to actually send email ---
# Example values for Gmail (use an "App Password", not your normal password):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=your-16-char-app-password
#
# Or use a transactional provider like Resend / SendGrid / Mailgun's SMTP creds.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=eyerusalem0201@gmail.com
SMTP_PASS=phmzdebadpentbnd
